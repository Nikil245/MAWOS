# Explicit application mode: development, test, or production.
MAWOS_ENV=development

# Database target is deliberately explicit. The default `external` means the
# existing host PostgreSQL database; Compose does not start a database service.
# Use `docker` only with docker-compose.docker-db.yml and its separate volume.
MAWOS_DATABASE_MODE=external
# PostgreSQL uses Psycopg 3. Native host processes (Alembic, verification and
# scripts) use loopback. Do not replace this host with host.docker.internal.
MAWOS_DATABASE_URL=postgresql+psycopg://mawos_app:replace-with-password@127.0.0.1:5432/mawos
# Docker backend containers use the host gateway. Compose passes this value as
# their internal MAWOS_DATABASE_URL; it is intentionally separate from the
# native URL above. Both URLs target the same existing MAWOS database.
MAWOS_DOCKER_DATABASE_URL=postgresql+psycopg://mawos_app:replace-with-password@host.docker.internal:5432/mawos
# Timetable bootstrap writes remain disabled unless an operator temporarily sets this true.
MAWOS_ALLOW_TIMETABLE_BOOTSTRAP=false
# Optional explicit policy; blank means new requirements are reported as blocked.
MAWOS_TIMETABLE_DEFAULT_WEEKLY_PERIODS=

# Generate a long random value for every environment. The development fallback
# is intentionally insecure and must never be used in production.
MAWOS_JWT_SECRET=replace-with-a-long-random-secret

# Demo accounts are never created unless this is explicitly enabled outside
# production. Keep false for normal development and all production deployments.
MAWOS_SEED_DEMO_DATA=false

# Optional generative AI. Groq is preferred in auto mode after a real models
# check; Ollama is the optional local fallback. Leave the key blank to disable
# hosted calls safely. Never use a VITE_ prefix for this server-only secret.
MAWOS_AI_PROVIDER=auto
GROQ_API_KEY=
MAWOS_GROQ_BASE_URL=https://api.groq.com/openai/v1
MAWOS_GROQ_MODEL=openai/gpt-oss-20b
MAWOS_GROQ_TIMEOUT_SECONDS=30
MAWOS_GROQ_MAX_TOKENS=180
MAWOS_GROQ_MAX_INPUT_CHARS=6000
MAWOS_GROQ_HEALTH_TTL=30
MAWOS_GROQ_RETRY_COOLDOWN=5
MAWOS_AI_REQUESTS_PER_MINUTE=6

# Host-native Ollama endpoint for `python run.py`.
MAWOS_OLLAMA_HOST=http://127.0.0.1:11434
# With `--profile local-ai`, the backend container reaches the optional Ollama
# service over this private URL. Backend startup never waits for Ollama.
MAWOS_DOCKER_OLLAMA_HOST=http://ollama:11434
MAWOS_OLLAMA_MODEL=qwen2.5:3b
# One complete Ollama assistant-turn deadline in seconds (maximum 600): health
# probing plus every tool/final model round. It is not multiplied internally.
MAWOS_OLLAMA_TIMEOUT_SECONDS=90
# Tested local deployment limits for an RTX 3050 4 GB. Context/output values
# are sent to Ollama as num_ctx and num_predict; output is capped at 180.
MAWOS_OLLAMA_CONTEXT=2048
MAWOS_OLLAMA_MAX_OUTPUT_TOKENS=160
# Keep the model resident for this many idle seconds after a normal request.
MAWOS_OLLAMA_KEEP_ALIVE_SECONDS=300
MAWOS_OLLAMA_MAX_RESPONSE_CHARS=12000
MAWOS_OLLAMA_MAX_ROUNDS=2
MAWOS_OLLAMA_CONCURRENCY=1
# Bounded availability recovery; these control check reuse/cooldown only.
MAWOS_OLLAMA_HEALTH_TTL=5
MAWOS_OLLAMA_RETRY_COOLDOWN=2
MAWOS_PROVENANCE_GATE=1

# Placement classifier cutoff; hard rules always run before model scoring.
MAWOS_PLACEMENT_MODEL_THRESHOLD=0.5
# Private PDF storage. In Docker this path is backed by the non-public named
# volume below; back up this volume together with PostgreSQL for consistency.
MAWOS_PLACEMENT_DOCUMENT_ROOT=./runtime/placement-documents
MAWOS_PLACEMENT_DOCUMENT_MAX_BYTES=10485760

# Frontend API URL, embedded at frontend build time. `/api` is the same-origin
# default used by the Docker Nginx proxy and Vite's development proxy. For a
# separately hosted API use a browser-reachable URL, never a Docker hostname.
VITE_API_BASE_URL=/api

# Docker PostgreSQL settings. Used only with docker-compose.docker-db.yml.
# A fresh named volume is empty until an operator explicitly restores or
# initializes it; Compose never migrates, resets, or deletes it.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=mawos
POSTGRES_USER=mawos_app
POSTGRES_PASSWORD=replace-with-a-strong-password

# Physical library (INR, in-person fine collection; calendar days in Asia/Kolkata)
MAWOS_LIBRARY_LOAN_DAYS=7
MAWOS_LIBRARY_PICKUP_DEADLINE_DAYS=2
MAWOS_LIBRARY_FINE_PER_OVERDUE_DAY=1
MAWOS_LIBRARY_MISSED_PICKUP_FINE=10
MAWOS_LIBRARY_FINE_BLOCK_THRESHOLD=25
MAWOS_LIBRARY_RECOMMENDATION_LIMIT=5
