# Explicit application mode: development, test, or production.
MAWOS_ENV=development

# PostgreSQL uses Psycopg 3. This value belongs only in your ignored .env.
MAWOS_DATABASE_URL=postgresql+psycopg://mawos_app:replace-with-password@127.0.0.1:5432/mawos

# Generate a long random value for every environment. The development fallback
# is intentionally insecure and must never be used in production.
MAWOS_JWT_SECRET=replace-with-a-long-random-secret

# Demo accounts are never created unless this is explicitly enabled outside
# production. Keep false for normal development and all production deployments.
MAWOS_SEED_DEMO_DATA=false

# Optional local Ollama assistant. MAWOS does not contact Ollama at startup;
# this is checked only for eligible low-confidence chat turns.
MAWOS_OLLAMA_HOST=http://127.0.0.1:11434
MAWOS_OLLAMA_MODEL=qwen2.5:3b
# One complete Ollama assistant-turn deadline in seconds: health probing plus
# every tool/final model round. It is not multiplied internally.
MAWOS_OLLAMA_TIMEOUT=20
# Tested local deployment limits for an RTX 3050 4 GB. Context/output values
# are sent to Ollama as num_ctx and num_predict.
MAWOS_OLLAMA_CONTEXT=2048
MAWOS_OLLAMA_MAX_OUTPUT_TOKENS=192
MAWOS_OLLAMA_MAX_RESPONSE_CHARS=12000
MAWOS_OLLAMA_MAX_ROUNDS=2
MAWOS_OLLAMA_CONCURRENCY=1
# Bounded availability recovery; these control check reuse/cooldown only.
MAWOS_OLLAMA_HEALTH_TTL=5
MAWOS_OLLAMA_RETRY_COOLDOWN=2
MAWOS_PROVENANCE_GATE=1
